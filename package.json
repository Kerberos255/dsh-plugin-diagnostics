{
  "name": "dsh-plugin-diagnostics",
  "version": "0.1.7",
  "type": "module",
  "description": "Privacy-restricted JSONL lifecycle and failure diagnostics for DeepSeek Harness plugins.",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./logger": "./logger.js"
  },
  "files": [
    "index.js",
    "logger.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "compatibility.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1 || >=4.0.4 <5.0.0",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2 || 0.2.1-rc.2 || 0.2.1-alpha.1 || >=0.2.1",
    "@deepseek-ai/dsh-app-boot": "0.2.0-rc.2 || 0.2.1-rc.2 || 0.2.1-alpha.1 || >=0.2.1"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.0-rc.2"
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "diagnostics",
    "logging"
  ],
  "dshCompatibility": {
    "testedRuntime": "0.2.1-rc.2",
    "policy": "warn"
  }
}
