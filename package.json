{
  "name": "dsh-plugin-diagnostics",
  "version": "0.1.3",
  "type": "module",
  "description": "统一收集本地插件的加载、失败与任务状态，脱敏写入按日轮转的 JSONL 日志。",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./logger": "./logger.js"
  },
  "files": [
    "index.js",
    "logger.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.4 || 4.0.5-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2 || 0.2.1-alpha.1"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "diagnostics",
    "logging"
  ]
}
